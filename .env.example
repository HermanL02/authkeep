# Only for running docker-compose.yml locally. On Coolify these are generated for you.
SERVICE_USER_POSTGRES=authkeep
SERVICE_PASSWORD_64_POSTGRES=local-postgres-password
SERVICE_PASSWORD_64_APIKEY=local-api-key-0123456789abcdef
SERVICE_PASSWORD_64_ENCRYPTION=local-encryption-key-0123456789abcdef
SERVICE_PASSWORD_WEBPASSWORD=local-password
SERVICE_PASSWORD_64_SESSION=local-session-secret-0123456789abcdef
