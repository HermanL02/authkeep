PORT=3000
DATABASE_URL=postgres://authkeep:authkeep@localhost:5432/authkeep
DATABASE_SSL=false
# Comma-separated, each at least 16 chars. Generate with: openssl rand -hex 32
API_KEYS=change-me-to-a-long-random-key
# At least 32 chars. Losing or changing it makes stored secrets unreadable.
ENCRYPTION_KEY=change-me-to-a-long-random-encryption-key
